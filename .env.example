# GP Parts — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local est ignoré par git (voir .gitignore : .env*.local)

# ─── SEO : URL canonique du site ───
# Domaine public définitif (sert au sitemap, robots, canonical, OG).
# TODO(Stéphane): mettre le vrai domaine (ex: https://car-performance.gp).
# Non défini → défaut = preview Vercel (cf. lib/seo.ts).
NEXT_PUBLIC_SITE_URL=https://gp-parts.vercel.app

# ─── Firebase (Phase 4 : cloud) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emulateur local (mettre true pour dev avec emulateur)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# ─── Firebase Admin SDK (server-only — SANS préfixe NEXT_PUBLIC_) ───
# Créer un compte de service dans Firebase Console > Project Settings > Service accounts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La clé privée PEM — encoder les sauts de ligne en \n littéral (une seule ligne)
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Contact WhatsApp ───
# Numéro WhatsApp complet sans espaces ni tirets (ex: 590123456789)
NEXT_PUBLIC_WHATSAPP_NUMBER=590000000000

# ─── Phase 6+ : Resend (emails transactionnels) ───
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=commandes@gp-parts.example
# RESEND_ADMIN_EMAIL=stephane@example.com

# ─── Phase 6 : Stripe (paiement carte) ───
# Toutes en mode TEST tant que le compte live n'est pas ouvert.
# Dashboard Stripe > Developers > API keys (sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret du webhook (Dashboard > Webhooks, ou `stripe listen` en local : whsec_…)
STRIPE_WEBHOOK_SECRET=
