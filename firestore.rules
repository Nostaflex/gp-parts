rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user authentifié + email vérifié + email dans whitelist meta/admins
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/meta/admins)
          && get(/databases/$(database)/documents/meta/admins).data.emails.hasAny([request.auth.token.email]);
    }

    // Catalogue public en lecture (actifs seulement), admin en écriture + lecture supprimés
    match /products/{doc=**} {
      // .get('deletedAt', null) tolère le champ absent (rétrocompat seed
       // legacy) — un doc sans deletedAt est traité comme actif/visible.
       allow read: if resource.data.get('deletedAt', null) == null || isAdmin();
      allow write: if isAdmin();
    }

    match /vehicules/{doc=**} {
      allow read;
      allow write: if isAdmin();
    }

    match /motos/{doc=**} {
      allow read;
      allow write: if isAdmin();
    }

    // Commandes: création publique (checkout), lecture/update admin, jamais delete
    match /orders/{doc} {
      allow create;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Demandes (leads formulaires contact + RDV réparation) : écriture
    // EXCLUSIVEMENT via Admin SDK (server actions, après validation + honeypot).
    // create:if false bloque toute écriture client directe (anti-spam).
    // Pas hard delete (RGPD: soft delete via status='deleted').
    match /demandes/{doc} {
      allow create: if false;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Avis clients : dépôt via Admin SDK uniquement (Server Action validée),
    // lecture publique via cache serveur — jamais en direct client.
    match /avis/{doc} {
      allow create: if false;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Leboncoin drafts: admin only (lecture + écriture)
    match /leboncoin_drafts/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Audit log: immutable, jamais update/delete même admin
    match /audit_log/{doc} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Feature flags de sections : lecture publique (rendu storefront non
    // authentifié), écriture admin seulement. Plus spécifique que
    // /meta/{doc=**} ci-dessous ; les règles Firestore sont en OR, donc cette
    // règle accorde la lecture publique sans toucher le reste de meta/.
    match /meta/featureFlags {
      allow read;
      allow write: if isAdmin();
    }

    // Coordonnées de contact : lecture publique (storefront + JSON-LD),
    // écriture admin seulement.
    match /meta/contactInfo {
      allow read;
      allow write: if isAdmin();
    }

    // Meta (whitelist admins + config): admin only
    // Note: meta/admins contient PII (emails admins), pas lecture publique
    match /meta/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Legacy metadata (rétro-compat, lecture publique catégories)
    match /metadata/{docId} {
      allow read;
      allow write: if isAdmin();
    }

    // Parc de location: lecture publique (actifs seulement), admin en écriture.
    // .get('deletedAt', null) tolère le champ absent (même contrat que products).
    match /location-cars/{doc=**} {
      allow read: if resource.data.get('deletedAt', null) == null || isAdmin();
      allow write: if isAdmin();
    }

    // Réservations: écriture EXCLUSIVEMENT via Admin SDK (server action location,
    // après validation + honeypot). create:if false bloque l'écriture directe.
    match /reservations/{doc} {
      allow create: if false;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
