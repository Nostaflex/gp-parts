rules_version = '2';

// DENY-ALL par conception (audit 2026-08-19).
//
// Le bucket n'a AUCUN accès légitime via les rules :
//  - écritures : uniquement /api/admin/upload (Admin SDK = service account,
//    non soumis aux rules) — c'est là que vivent les gardes réels
//    (requireAdmin, magic-bytes, 8 Mo, anti path-traversal, MAX_INDEX) ;
//  - lectures : uniquement des URLs de download à token
//    (firebasestorage.googleapis.com…token=…), non soumises aux rules.
//
// Toute règle allow ici serait un chemin de CONTOURNEMENT de ces gardes
// (ex. un compte admin compromis uploadant 25 Mo via SDK client), pas une
// protection. Vérifié en prod le 2026-08-19 : 0 URL stockée ne dépend des
// rules. Si un jour un accès client direct devient nécessaire, le rouvrir
// chemin par chemin — jamais en réactivant un allow write générique.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
