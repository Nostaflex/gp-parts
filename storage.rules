rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: vérifie que l'utilisateur est dans la whitelist Firestore meta/admins
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && firestore.exists(/databases/(default)/documents/meta/admins)
          && firestore.get(/databases/(default)/documents/meta/admins)
                      .data.emails.hasAny([request.auth.token.email]);
    }

    // Photos catalogue (véhicules / motos / produits): lecture publique pour servir le site
    // Écriture admin only + validation taille + content-type
    match /vehicules/{vehiculeId}/{file=**} {
      allow read;
      allow write: if isAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    match /motos/{motoId}/{file=**} {
      allow read;
      allow write: if isAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    match /products/{productId}/{file=**} {
      allow read;
      allow write: if isAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
